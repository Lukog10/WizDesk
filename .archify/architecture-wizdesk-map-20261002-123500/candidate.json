    {
      "dot": "rose",
      "title": "Zero-Telemetry Security & Local Storage",
      "items": [
        "Encrypted at Rest: Database file sealed with AES-256-GCM authenticated encryption",
        "In-Memory Speed: Zero-lag UI execution over an in-memory SQLite database",
        "OS Credential Gate: Windows Hello / CredUI authentication protects private master recovery key exports",
