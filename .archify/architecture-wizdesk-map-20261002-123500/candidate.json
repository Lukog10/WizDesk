  "cards": [
    {
      "dot": "emerald",
      "title": "User Interaction & 5 Core Workspace Views",
      "items": [
        "Desktop User: Invokes the application via global shortcut (Ctrl+Shift+Space) or direct tray launch into the Workspace Hub",
        "Tasks Hub: Hierarchical task management with 24 preset colors, description, auto-track keywords, and subtasks",
        "Projects Dashboard: Hero KPI card, dual-mode project comparison bar chart, and application usage donut",
        "Activity Timeline: Chronological activity stream visualizing application sessions and completed task milestones",
        "Calendar Schedule & Notes: Monthly calendar agenda planner and persistent daily timestamped scratchpad"
      ]
    },
    {
      "dot": "cyan",
      "title": "Desktop Companion & Autonomous Tracking",
      "items": [
        "Desktop Mascot: Transparent floating window with real-time cursor eye tracking and click-to-open Quick Bar popups",
        "Autonomous Tracking: Continuous 5s background polling loop attributing active application windows without manual timers",
        "Privacy-First Sanitizer: In-flight redaction of sensitive window titles, credentials, banking portals, and private browsing",
        "Companion State Engine: Reactive mascot moods reflecting focus, celebration, system alerts, and inactivity sleep"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-Telemetry Security & Local Storage",
      "items": [
        "5 Individual View Connections: Every workspace view communicates directly and independently with StorageRepository",
        "Encrypted SQLite Engine: Sealed disk file protected with authenticated AES-256-GCM encryption with in-memory execution",
        "OS Credential Gate: Windows Hello / CredUI authentication challenges users before viewing or exporting private recovery keys",
        "Sync & Backup: Automated debounced daily log export to Obsidian Markdown vaults and encrypted database snapshots"
      ]
    }
  ]
}